# Servidor HTTP
PORT=3000
NODE_ENV=development

# Banco de Dados Relacional MySQL 8.0
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=casetrack

# Redis (Cache Distribuído & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Autenticação JWT
JWT_SECRET=super_secret_jwt_casetrack_key_2026
JWT_EXPIRES_IN=7d

# Criptografia Simétrica (AES-256-GCM - 64 caracteres hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Integração Externa Google Calendar API v3
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost/api/v1/productions/google/callback
